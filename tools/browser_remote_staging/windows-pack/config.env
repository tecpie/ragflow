# RAGFlow Browser Gateway 配置
# 修改后重新运行 start.bat

# 对外端口（CDP + staging 共用）
BROWSER_GATEWAY_PORT=19080

# 本机 Chrome CDP 地址（Chrome 只需监听本机，不必对外）
BROWSER_CDP_UPSTREAM=http://127.0.0.1:9222

# 上传文件落盘目录（Chrome 必须能读取此目录下的文件）
BROWSER_STAGING_DIR=C:\ProgramData\ragflow\browser-uploads

# 与 RAGFlow Browser 节点 remote_staging_token 保持一致
BROWSER_STAGING_TOKEN=change-me

# 若 RAGFlow 通过固定域名/IP 访问，建议填写，便于重写 CDP WebSocket 地址
# BROWSER_GATEWAY_PUBLIC_ORIGIN=http://192.168.1.100:19080

# 单文件最大上传大小（字节），默认 104857600 = 100MB
# BROWSER_STAGING_MAX_BYTES=104857600
