# Copy to test-server.env (gitignored) in this directory and adjust as needed.

SYNC_HOST=172.16.0.31
SYNC_USER=root
SYNC_DOCKER_COMPOSE=docker-compose

# Optional: private key path (default ~/.ssh/id_ed25519_ragflow)
# SYNC_SSH_KEY=~/.ssh/id_ed25519_ragflow

# Only needed for first-time `.\scripts\sync-to-test-server.ps1 --setup-ssh`
# SYNC_PASS=

# --- Docker images (docker/build_amd64_image.sh) ---
# Debug uses floating dev tag; stable uses commit-pinned tag on release.
DEBUG_RAGFLOW_IMAGE=registry.cn-hangzhou.aliyuncs.com/tecpie/ragflow:amd64-dev
# STABLE_RAGFLOW_IMAGE=registry.cn-hangzhou.aliyuncs.com/tecpie/ragflow:amd64-dev-9421a03c7
# If STABLE_RAGFLOW_IMAGE is unset, --release-stable uses amd64-<branch>-<local-git-short-commit>

# --- Deploy targets (script defaults to debug) ---
#
# Both --full and --release-stable sync local docker/ into the compose dir.
# .env is merged: keep existing values, append only new keys from docker/.env.
#
# Debug incremental (daily — edit mounted code on 31):
#   .\scripts\sync-to-test-server.ps1 --incremental
#   http://172.16.0.31:8080  API :9390
#
# Frontend: local npm build + zip upload (not docker exec build):
#   .\scripts\sync-to-test-server.ps1 --build-web
#
# Debug full (sync docker/ + amd64-dev image + docker cp ragflow/):
#   .\scripts\sync-to-test-server.ps1 --full --migrate
#
# Stable (sync docker/ without code mount + pinned image recreate):
#   .\scripts\sync-to-test-server.ps1 --release-stable --target stable
#   http://172.16.0.31  API :9380
#
# Optional per-target overrides (defaults shown):
# SYNC_REMOTE_BASE_DEBUG=/data/docker/ragflow-debug/ragflow
# SYNC_DOCKER_DIR_DEBUG=/data/docker/ragflow-debug
# SYNC_CONTAINER_DEBUG=ragflow-debug
# SYNC_REMOTE_BASE_STABLE=/data/docker/ragflow/ragflow
# SYNC_DOCKER_DIR_STABLE=/data/docker/ragflow
# SYNC_CONTAINER_STABLE=ragflow
