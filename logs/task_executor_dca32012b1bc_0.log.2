arts, requiring safety verification.\")##\n(\"relationship\"<|>\"电力调度机构\"<|>\"电力交易机构\"<|>\"Coordinates by providing safety constraints and grid data to enable market operations and transaction execution.\"<|>\"data sharing, operational coordination\"<|>9)##\n(\"relationship\"<|>\"电力调度机构\"<|>\"独立辅助服务提供商\"<|>\"Conducts technical tests to validate service providers' capabilities before market entry.\"<|>\"technical validation, market access\"<|>8)##\n(\"relationship\"<|>\"省发展改革委\"<|>\"西北能源监管局\"<|>\"Jointly enforces regulations, handles forced market exits, and maintains credit evaluation systems.\"<|>\"regulatory enforcement, compliance oversight\"<|>9)##\n(\"relationship\"<|>\"陕西电力交易平台\"<|>\"交易中心\"<|>\"Platform operated by the trading center for registration processes, information disclosure, and transaction execution.\"<|>\"platform management, registration facilitation\"<|>8)##\n(\"relationship\"<|>\"发电企业\"<|>\"陕西电力交易平台\"<|>\"Must register on this platform to participate in market transactions and provide required documentation.\"<|>\"mandatory registration, market access\"<|>7)##\n(\"relationship\"<|>\"电力用户\"<|>\"陕西电力交易平台\"<|>\"Required to register for wholesale transactions; retail participants undergo simplified record-filing procedures.\"<|>\"registration requirement, market entry\"<|>7)##\n(\"relationship\"<|>\"售电公司\"<|>\"陕西电力交易平台\"<|>\"Must complete registration and publicity processes on this platform to operate legally in the market.\"<|>\"compliance, operational authorization\"<|>8)##\n(\"relationship\"<|>\"跨省跨区交易\"<|>\"陕西省\"<|>\"Defined as trading activities involving Shaanxi-based entities and those outside the province/region.\"<|>\"regional trading, market scope\"<|>8)##\n(\"relationship\"<|>\"电力直接交易\"<|>\"电网企业\"<|>\"Grid companies provide essential transmission/distribution services to facilitate these transactions.\"<|>\"infrastructure support, service provision\"<|>8)##\n(\"relationship\"<|>\"合同电量转让交易\"<|>\"电力调度机构\"<|>\"Requires safety verification b