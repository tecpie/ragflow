ry\"<|>\"Matching coefficient (range [0,1]) determining matched clearing prices.\")##\n(\"entity\"<|>\"月度分日电量比例\"<|>\"category\"<|>\"Monthly daily electricity ratio decomposing monthly contracts into daily allocations.\")##\n(\"entity\"<|>\"日分时电量曲线\"<|>\"category\"<|>\"Daily time-sharing electricity curves (D1-D4) distributing power across 96 timepoints.\")##\n(\"relationship\"<|>\"陕西省电力市场管理委员会\"<|>\"差值系数K边际出清\"<|>\"The committee reviews and approves adjustments to the K_marginal_clearing coefficient.\"<|>\"regulatory oversight, parameter adjustment\"<|>9)##\n(\"relationship\"<|>\"陕西省电力市场管理委员会\"<|>\"差值系数K合匹配\"<|>\"The committee reviews and approves adjustments to the K_matching coefficient.\"<|>\"regulatory oversight, parameter adjustment\"<|>9)##\n(\"relationship\"<|>\"能源监管机构\"<|>\"差值系数K边际出清\"<|>\"The agency reviews and approves changes to K_marginal_clearing alongside provincial authorities.\"<|>\"regulatory approval, market operations\"<|>8)##\n(\"relationship\"<|>\"陕西省政府有关主管部门\"<|>\"差值系数K边际出清\"<|>\"Provincial departments review and approve K_marginal_clearing adjustments.\"<|>\"government oversight, policy implementation\"<|>8)##\n(\"relationship\"<|>\"电力交易机构\"<|>\"电网企业\"<|>\"Collaborate with grid companies to propose monthly typical trading curves.\"<|>\"market operations, curve development\"<|>7)##\n(\"relationship\"<|>\"电力交易机构\"<|>\"电力调度机构\"<|>\"Work with dispatching agencies to develop electricity decomposition methods.\"<|>\"operational coordination, market design\"<|>7)##\n(\"relationship\"<|>\"统一边际出清\"<|>\"撮合匹配、边际出清\"<|>\"Both are market clearing mechanisms defined in the same regulatory framework.\"<|>\"trading methodologies, market rules\"<|>8)##\n(\"relationship\"<|>\"标准能量块交易\"<|>\"日分时电量曲线\"<|>\"Energy block trading uses time-sharing curves to decompose contract holdings.\"<|>\"market mechanisms, data processing\"<|>7)##\n(\"content_keywords\"<|>\"electricity market, trading mechanisms, regulatory framework, contract management, energy decomposition\")