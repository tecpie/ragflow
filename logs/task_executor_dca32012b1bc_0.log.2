n(\"relationship\"<|>\"电力调度机构\"<|>\"关键通道可用输电容量\"<|>\"Provides monthly/annual transmission capacity data for key corridors to enable transaction clearing.\"<|>\"infrastructure management, data provision\"<|>8)##\n(\"relationship\"<|>\"年度交易\"<|>\"月度交易\"<|>\"Annual transactions set monthly allocations; monthly results are aggregated and adjusted based on annual frameworks.\"<|>\"temporal integration, planning hierarchy\"<|>7)##\n(\"relationship\"<|>\"上下调预挂牌机制\"<|>\"偏差电量处理\"<|>\"Primary mechanism for resolving deviations between actual demand and generation plans via price-based adjustments.\"<|>\"deviation mitigation, price signaling\"<|>9)##\n(\"content_keywords\"<|>\"electricity market regulations, renewable energy integration, transmission capacity, safety verification, transaction mechanisms\")<|COMPLETE|>"
