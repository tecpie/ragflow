e\":\"21198124000R\",\"prj_name\":\"国网四川超高压公司绵阳分部500kV长谭一线避雷器补装\",\"prj_type\":\"01\",\"create_by\":1,\"line_type\":\"01\",\"plan_year\":\"2026\",\"prj_stage\":\"02\",\"ast_nature\":\"1\",\"prj_nature\":\"99\",\"prj_status\":2,\"device_name\":\"一线避雷器\",\"impl_org_id\":\"ff80808151703de001517a3709030fc1\",\"prj_library\":\"0103\",\"prj_end_time\":\"2027-12-31 00:00:00\",\"total_invest\":111.84,\"category_code\":\"01\",\"exist_problem\":\"500kV长谭一线线路途径区域多为高山、山地地形，雷电活动频繁、地闪密度大（III、IV级雷击风险区），曾多次因雷击发生故障跳闸，线路在雷雨季节运行面临较大雷击跳闸风险。\",\"impl_org_name\":\"国网四川电力\",\"program_scale\":\"经防雷评估，对500kV长谭一线170#、177#、229#、241#、242#、250#、256#、263#、266#、268#、275#、280#、284#、344#、351#、358#、361#共17基铁塔两边相补装34套交流线路避雷器，以提高线路防雷水平。\",\"prj_start_time\":\"2026-01-01 00:00:00\",\"process_status\":\"16F37FCEBB150ED1E0530100007F2F45\",\"invest_org_name\":\"西南分部\",\"equip_status_quo\":\"绵阳分部所辖500kV长谭一线由原2003年9月投运的500kV南谭一线开π形成，线路于2022年01月投运，现起于500kV长坪山变电站，止于500kV谭家湾变电站，绵阳分部管辖线路区段为141#-365#，线路长度119.731公里，铁塔225基，线路途经遂宁市射洪市、绵阳市三台县、德阳市罗江区等地。\",\"prj_management_type\":\"限下\",\"professional_category\":\"2\",\"professional_subdivison\":\"21\",\"station_line_volt_level\":\"交流500kV\"}],\"rules\":[{\"errorMessage\":\"当前文档与同项目中其他文档信息存在不一致！\",\"id\":\"01ksfpgx2e5hbcsbq4xjfxab2q\",\"priority\":2,\"promptWordConfiguration\":\"检查当前文档中建设内容是否与项目内其他已审核通过的文档中建设内容一致，注意项目内其他文档是指，同一个项目下的不同文档类型，需要验证同一个项目下的不同文档建设内容是否一样；\",\"ruleClassification\":\"01\",\"ruleName\":\"同项目跨文档一致性审查\",\"severity\":1},{\"errorMessage\":\"当前项目与过往项目存在重复立项！\",\"id\":\"01ksfpn3s5cdnby9rrrey9erva\",\"priority\":2,\"promptWordConfiguration\":\" 检查当前文档中项目是否与系统内其他项目的信息存在重复或冲突（重复立项校验）\\n列如25年申报过，且系统存在了的项目，26年再进行申报，不允许重复申报立项；\",\"ruleClassification\":\"01\",\"ruleName\":\"项目是否存在重复立项\",\"severity\":1},{\"errorMessage\":\"当前项目基本信息有误，与项目基本信息不一致！\",\"id\":\"01ksfpcz4s2fbbwj6vas3kg4yq\",\"priority\":2,\"promptWordConfiguration\":\"检查当前文档中项目是否与项目基础信息库中的数据完全一致，比如总投资金额，项目开始时间，项目结束时间等字段关键信息，以及项目名称等\",\"ruleClassification\":\"01\",\"ruleName\":\"项目基本信息校验\",\"severity