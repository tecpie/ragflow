    "title": "6.3巡视检查",
    "chunk_id": "105"
  },
  {
    "level": "3",
    "title": "6.3.1继电保护及安全自动装置的巡视应符合DL/T587的相关规定。",
    "chunk_id": "105"
  },
  {
    "level": "2",
    "title": "6.5事故和故障处理",
    "chunk_id": "106"
  },
  {
    "level": "3",
    "title": "6.5.1继电保护及安全自动装置事故处理应符合DL/T587的相关规定。",
    "chunk_id": "106"
  },
  {
    "level": "3",
    "title": "6.1.2定值通知单管理",
    "chunk_id": "107"
  },
  {
    "level": "2",
    "title": "7.4定期检验的内容与周期",
    "chunk_id": "109"
  },
  {
    "level": "3",
    "title": "7.4.1定期检验应根据DL/T995规定及标准化作业指导书的内容进行。",
    "chunk_id": "109"
  },
  {
    "level": "2",
    "title": "6.4装置操作",
    "chunk_id": "110"
  },
  {
    "level": "3",
    "title": "6.4.1继电保护及安全自动装置的操作应符合DL/T587的相关规定。",
    "chunk_id": "110"
  },
  {
    "level": "2",
    "title": "7.3检验分类",
    "chunk_id": "111"
  },
  {
    "level": "1",
    "title": "7检验阶段监督",
    "chunk_id": "116"
  },
  {
    "level": "2",
    "title": "7.1检验基本要求",
    "chunk_id": "116"
  },
  {
    "level": "2",
    "title": "7.7现场检验的保安重点",
    "chunk_id": "127"
  },
  {
    "level": "2",
    "title": "7.6现场检验",
    "chunk_id": "130"
  },
  {
    "level": "1",
    "title": "DL/T2253-2021",
    "chunk_id": "133"
  },
  {
    "level": "2",
    "title": "7.5补充检验的内容",
    "chunk_id": "135"
  },
  {
    "level": "1",
    "title": "中华人民共和国\n电力行业标准\n发电厂继电保护及安全自动装置技术监督导则\nDL/T2253—2021",
    "chunk_id": "141"
  },
  {
    "level": "2",
    "title": "7.7.8传动或整组试验后不应再在二次回路上进行任何工作，否则应做相应的检验。",
    "chunk_id": "143"
  },
  {
    "level": "2",
    "title": "7.7.10工作结束，全部设备和回路应恢复到工作开始前状态。",
    "chunk_id": "146"
  },
  {
    "level": "2",
    "title": "7.7.7进行现场工作时，应防止交流和直流回路混线。",
    "chunk_id": "149"
  },
  {
    "level": "2",
    "title": "7.7.6现场工作应以图纸为依据，工作中若发现图纸与实际接线不符，应查线核对。",
    "chunk_id": "152"
  }
]
