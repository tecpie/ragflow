hings up. Paragraphs as following:\n      {cluster_content}\nThe above is the content you need to summarize.", "max_token": 256, "threshold": 0.1, "max_cluster": 64, "random_seed": 0}, "graphrag": {"use_graphrag": true, "entity_types": ["organization", "person", "geo", "event", "category"], "method": "light"}, "llm_id": "deepseek-r1@Tongyi-Qianwen"}, "img2txt_id": "", "asr_id": "", "llm_id": "deepseek-r1@Tongyi-Qianwen", "update_time": 1776235992909, "doc_ids": ["25c99e60370b11f1bbd741a0fffacb79", "3e48bdcc370b11f1bbd741a0fffacb79", "3f59a67c370b11f1bbd741a0fffacb79", "408ccfe2370b11f1bbd741a0fffacb79", "788ef8fc370b11f1bbd741a0fffacb79", "7a34feae370b11f1bbd741a0fffacb79", "9bb13ae8370b11f1bbd741a0fffacb79", "9c7ff5cc370b11f1bbd741a0fffacb79", "9df70a3a370b11f1bbd741a0fffacb79", "9f8cec3e370b11f1bbd741a0fffacb79", "afea3b90370b11f1bbd741a0fffacb79", "b026de60370b11f1bbd741a0fffacb79", "b0473d9a370b11f1bbd741a0fffacb79", "c2f1b39e370b11f1bbd741a0fffacb79", "c446a92a370b11f1bbd741a0fffacb79", "f57eb8ca370b11f1bbd741a0fffacb79", "f6530350370b11f1bbd741a0fffacb79", "f69440a4370b11f1bbd741a0fffacb79"], "task_type": "graphrag"}}}
