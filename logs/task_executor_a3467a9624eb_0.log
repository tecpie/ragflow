    "title": "第一百五十二条",
    "chunk_id": "236"
  },
  {
    "level": "2",
    "title": "第一百五十三条",
    "chunk_id": "237"
  },
  {
    "level": "2",
    "title": "以往规定与本规则不一致的，以本规则为准。",
    "chunk_id": "238"
  },
