|>\"category\"<|>\"日志库回滚最大个数是审计策略配置项之一，用于控制日志存储空间的使用上限。\")##\n(\"entity\"<|>\"审计上报类型\"<|>\"category\"<|>\"审计上报类型是审计策略配置内容，决定哪些类型的审计事件需要上报至管理中心。\")##\n(\"entity\"<|>\"审计日志条目数\"<|>\"category\"<|>\"审计日志条目数是审计策略配置项，用于设定单个日志库可容纳的日志数量。\")##\n(\"entity\"<|>\"导出功能\"<|>\"category\"<|>\"导出功能是审计日志支持的操作，允许将日志数据以文件形式保存以便后续分析。\")##\n(\"entity\"<|>\"查询响应时间\"<|>\"category\"<|>\"查询响应时间是系统性能指标，要求审计日志查询不超过5秒。\")##\n(\"entity\"<|>\"半年以上日志存储\"<|>\"category\"<|>\"半年以上日志存储是部署时对存储空间的要求，确保审计日志满足长期保留需求。\")##\n(\"entity\"<|>\"主频2.0GHz或以上\"<|>\"category\"<|>\"主频2.0GHz或以上是可信验证管理中心硬件参数中对处理器性能的基本要求。\")##\n(\"entity\"<|>\"CPU：2 颗四核\"<|>\"category\"<|>\"CPU：2 颗四核是可信验证管理中心硬件配置要求，表示处理器核心数量。\")##\n(\"entity\"<|>\"不低于16GB\"<|>\"category\"<|>\"不低于16GB是可信验证管理中心内存容量的最低要求。\")##\n(\"entity\"<|>\"不低于1TB\"<|>\"category\"<|>\"不低于1TB是可信验证管理中心硬盘容量的最低标准。\")##\n(\"entity\"<|>\"双电源\"<|>\"category\"<|>\"双电源是可信验证管理中心硬件供电配置，提高系统可靠性。\")##\n(\"entity\"<|>\"19 英寸及以上显示屏\"<|>\"category\"<|>\"19 英寸及以上显示屏是可信验证管理中心输入/输出设备的显示设备规格要求。\")##\n(\"entity\"<|>\"标准键盘、鼠标\"<|>\"category\"<|>\"标准键盘、鼠标是可信验证管理中心配套的输入设备，用于日常操作。\")##\n(\"entity\"<|>\"国产安全操作系统\"<|>\"category\"<|>\"国产安全操作系统是可信验证管理中心运行所依赖的操作系统，符合国家自主可控要求。\")##\n(\"entity\"<|>\"服务器\"<|>\"category\"<|>\"服务器是本项目新增硬件之一，需纳入安全III区网络安全管理平台统一管理。\")##\n(\"entity\"<|>\"路由器\"<|>\"category\"<|>\"路由器是本项目新增硬件设备，需纳入安全III区网络安全管理平台进行统一管控。\")##\n(\"entity\"<|>\"交换机\"<|>\"category\"<|>\"交换机是本项目新增硬件设备，包括内网与外网核心交换机，需纳入安全III区网络安全管理平台管理。\")##\n(\"entity\"<|>\"万兆硬件防火墙\"<|>\"category\"<|>\"万兆硬件防火墙是部署于安全III区外网核心交换机与调度、信息网络之间的高性能边界防护设备。\")##\n(\"entity\"<|>\"千兆硬件防火墙\"<|>\"category\"<|>\"千兆硬件防火墙是部署于安全III区外网核心交换机与电厂专用网之间的专用防火墙设备。\")##\n(\"entity\"<|>\"电力专用正向物理隔离装置\"<|>\"category\"<|>\"电力专用正向物理隔离装置是部署在安全III区与安全I、II区之间，实现数据单向传输的安全设备。\")##\n(\"entity\"<|>\"电力专用反向物理隔离装置\"<|>\"category\"<|>\"电力专用反向物理隔离装置是部署在安全III区与安全I、II区之间，防止外部数据反向渗透的安全设备。\")##\n(\"entity\"<|>\"主要设备材料清册\"<|>\"category\"<|>\"主要设备材料清册是附录1中列出的本项目所需硬件与软件设备清单，由西南电力设计院有限公司编制。\")##\n(\"entity\"<|>\"项目拟拆除设备材料清单\"<|>\"category\"<|>\"项目拟拆除设备材料清单是附录2中列出的